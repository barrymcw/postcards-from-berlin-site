---
// src/components/PortableText.astro
//
// Renders the body array from gallery/blogPost/siteSettings documents.
// Written by hand against our exact schema (rather than pulling in a
// generic third-party portable-text package) since the block types are
// few and specific: normal/heading/quote text blocks, numbered/bullet
// lists, bold/italic/underline/strikethrough/link marks, standalone
// captioned inline images, clustered image grids, and standalone video
// blocks. Keeping this self-contained avoids depending on a package whose
// current API can't be verified against what's actually installed.

import {uncroppedUrl} from '../lib/image';
import {fileUrl} from '../lib/video';

interface Props {
  blocks: any[];
}

const {blocks} = Astro.props;

// Groups consecutive list-item blocks of the same type together into a
// single <ol>/<ul>, the way portable text expects list items to render.
function groupListItems(blocks: any[]) {
  const groups: any[] = [];
  let currentList: any[] | null = null;
  let currentListType: string | null = null;

  for (const block of blocks) {
    if (block._type === 'block' && block.listItem) {
      if (currentListType !== block.listItem) {
        currentList = [];
        currentListType = block.listItem;
        groups.push({type: 'list', listType: block.listItem, items: currentList});
      }
      currentList!.push(block);
    } else {
      currentList = null;
      currentListType = null;
      groups.push({type: 'single', block});
    }
  }
  return groups;
}

function escapeHtml(s: string) {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

// Only allow normal link targets (no javascript: etc.).
function safeHref(href: unknown) {
  if (typeof href !== 'string') return null;
  const h = href.trim();
  return /^(https?:|mailto:|tel:|\/|#)/i.test(h) ? h : null;
}

const MARK_TAGS: Record<string, string> = {
  strong: 'strong',
  em: 'em',
  underline: 'u',
  'strike-through': 's',
};

// Turns a block's spans into an HTML string. Marks nest properly, so text
// that is bold AND italic AND a link keeps all three (the previous version
// only kept one mark per span). All text is escaped.
function inlineHtml(block: any): string {
  const markDefsByKey: Record<string, any> = {};
  for (const def of block.markDefs || []) markDefsByKey[def._key] = def;

  return (block.children || [])
    .map((span: any) => {
      if (span._type && span._type !== 'span') return '';
      let html = escapeHtml(span.text || '');
      for (const mark of span.marks || []) {
        const tag = MARK_TAGS[mark];
        if (tag) {
          html = `<${tag}>${html}</${tag}>`;
        } else if (markDefsByKey[mark]?._type === 'link') {
          const href = safeHref(markDefsByKey[mark].href);
          if (href) html = `<a href="${escapeHtml(href)}">${html}</a>`;
        }
      }
      return html;
    })
    .join('');
}

const groups = groupListItems(blocks || []);
---

{groups.map((group) => {
  if (group.type === 'list') {
    const Tag = group.listType === 'number' ? 'ol' : 'ul';
    return (
      <Tag>
        {group.items.map((block: any) => (
          <li set:html={inlineHtml(block)} />
        ))}
      </Tag>
    );
  }

  const block = group.block;

  if (block._type === 'block') {
    const html = inlineHtml(block);
    switch (block.style) {
      case 'h2': return <h2 class="pt-h2" set:html={html} />;
      case 'h3': return <h3 class="pt-h3" set:html={html} />;
      case 'h4': return <h4 class="pt-h4" set:html={html} />;
      case 'blockquote': return <blockquote class="pt-quote" set:html={html} />;
      default: return <p set:html={html} />;
    }
  }

  if (block._type === 'inlineImage') {
    return (
      <figure class="inline-img-figure">
        <button
          type="button"
          class="lightbox-trigger"
          data-lightbox-src={uncroppedUrl(block, 1800)}
          data-lightbox-alt={block.caption || ''}
        >
          <img class="inline-img" src={uncroppedUrl(block, 1400)} alt={block.caption || ''} />
        </button>
        {block.caption && <figcaption class="inline-caption">{block.caption}</figcaption>}
      </figure>
    );
  }

  if (block._type === 'imageGrid') {
    return (
      <div class="post-grid">
        {(block.images || []).map((img: any) => (
          <button type="button" class="lightbox-trigger" data-lightbox-src={uncroppedUrl(img, 1800)} data-lightbox-alt="">
            <img src={uncroppedUrl(img, 900)} alt="" />
          </button>
        ))}
      </div>
    );
  }

  if (block._type === 'videoBlock') {
    const src = fileUrl(block);
    if (!src) return null;
    return (
      <figure class="video-figure">
        <video class="inline-video" src={src} controls playsinline></video>
        {block.caption && <figcaption class="inline-caption">{block.caption}</figcaption>}
      </figure>
    );
  }

  return null;
})}

<style is:global>
  /* Default look for headings and quotes inside rich text. Written as plain
     class selectors so any page can still override them with its own CSS.
     Tweak sizes/spacing here and it applies site-wide. */
  .pt-h2,
  .pt-h3,
  .pt-h4 {
    color: rgba(0, 0, 0, 0.9);
    line-height: 1.2;
    margin: 2em 0 0.6em;
  }
  .pt-h2 {
    font-family: 'swear-display', serif;
    font-weight: 600;
    font-size: 1.6rem;
  }
  .pt-h3 {
    font-family: 'swear-display', serif;
    font-weight: 600;
    font-size: 1.3rem;
  }
  .pt-h4 {
    font-family: 'degular', sans-serif;
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }
  .pt-h2:first-child,
  .pt-h3:first-child,
  .pt-h4:first-child {
    margin-top: 0;
  }
  .pt-quote {
    margin: 1.6em 0;
    padding-left: 1.2rem;
    border-left: 2px solid #d8d5ca;
    font-family: 'swear-display', serif;
    font-style: italic;
    font-size: 1.15em;
    line-height: 1.45;
    color: #4a4943;
  }
</style>
