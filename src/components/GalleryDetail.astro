---
// src/components/GalleryDetail.astro
import PortableText from './PortableText.astro';
import {croppedUrl, uncroppedUrl} from '../lib/image';
import {fileUrl} from '../lib/video';

interface Props {
  gallery: any;
  prevGallery: {title: string; slug: {current: string}} | null;
  nextGallery: {title: string; slug: {current: string}} | null;
  basePath: string;
}
const {gallery, prevGallery, nextGallery, basePath} = Astro.props;

const videoSrc = gallery.video ? fileUrl(gallery.video) : null;
const hasYearGroups = gallery.yearGroups && gallery.yearGroups.length > 0;

// Newest year first, regardless of the order groups were entered in Studio.
const sortedYearGroups = hasYearGroups
  ? [...gallery.yearGroups].sort((a: any, b: any) => Number(b.year) - Number(a.year))
  : [];
---

<main>
  {gallery.headerImage && (
    <img class="gallery-header-img" src={croppedUrl(gallery.headerImage, 1400, 900)} alt="" />
  )}

  <div class="gallery-meta">
    <h1 class="gallery-title">{gallery.title}</h1>
    {gallery.materials && <p class="gallery-materials">{gallery.materials}</p>}
    {gallery.date && <p class="gallery-date">{gallery.date}</p>}

    {videoSrc && (
      <div class="gallery-video-wrap">
        <video class="gallery-video" src={videoSrc} controls playsinline></video>
        {gallery.video.caption && <p class="gallery-video-caption">{gallery.video.caption}</p>}
      </div>
    )}

    <div class="gallery-body">
      <PortableText blocks={gallery.body || []} />
    </div>
  </div>

  {hasYearGroups && (
    <div class="year-archive">
      <nav class="year-jump" aria-label="Jump to year">
        {sortedYearGroups.map((group: any) => (
          <a href={`#year-${group.year}`}>{group.year}</a>
        ))}
      </nav>

      {sortedYearGroups.map((group: any) => (
        <section class="year-section" id={`year-${group.year}`}>
          <h2 class="year-heading">{group.year}</h2>
          <div class="year-grid">
            {(group.images || []).filter((img: any) => img?.asset).map((img: any) => (
              <div class="year-grid-item">
                <img src={uncroppedUrl(img, 900)} alt="" />
                {img.caption && img.caption.length > 0 && (
                  <div class="year-caption">
                    <PortableText blocks={img.caption} />
                  </div>
                )}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  )}

  {!hasYearGroups && (
    <div class="gallery-grid">
      {(gallery.gridImages || []).filter((item: any) => item.image).map((item: any) => (
        <div class="grid-item">
          <img src={uncroppedUrl(item.image, 900)} alt="" />
          {item.caption && <span class="grid-item-caption">{item.caption}</span>}
        </div>
      ))}
    </div>
  )}

  {gallery.footerCopy && gallery.footerCopy.length > 0 && (
    <div class="gallery-footer-copy">
      <PortableText blocks={gallery.footerCopy} />
    </div>
  )}

  <nav class="gallery-pagination" aria-label="Gallery navigation">
    {prevGallery ? (
      <a href={`${basePath}/${prevGallery.slug.current}`}>
        <span class="pagination-label">&larr; Previous</span>
        <span class="pagination-name">{prevGallery.title}</span>
      </a>
    ) : <span />}
    {nextGallery ? (
      <a class="pagination-next" href={`${basePath}/${nextGallery.slug.current}`}>
        <span class="pagination-label">Next &rarr;</span>
        <span class="pagination-name">{nextGallery.title}</span>
      </a>
    ) : <span />}
  </nav>
</main>

<style>
  main {
    padding: 2rem 1.5rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .gallery-header-img {
    width: 100%;
    max-height: 65vh;
    object-fit: cover;
    margin-bottom: 2.5rem;
    background: #ececec;
  }
  .gallery-meta {
    max-width: 120ch;
    margin-bottom: 3rem;
  }
  .gallery-title {
    font-family: 'swear-display', serif;
    font-weight: 600;
    font-style: italic;
    font-size: 48px;
    line-height: 1.05;
    color: rgba(0, 0, 0, 0.9);
    margin: 0 0 0.75rem;
  }
  .gallery-materials {
    font-size: var(--body-size);
    color: #6b6a63;
    margin: 0 0 0.35rem;
  }
  .gallery-date {
    font-size: 0.85rem;
    color: #6b6a63;
    margin: 0 0 1.5rem;
  }
  .gallery-video-wrap {
    margin: 0 0 1.8rem;
  }
  .gallery-video {
    width: 100%;
    height: auto;
    display: block;
    background: #000;
  }
  .gallery-video-caption {
    font-size: 0.8rem;
    color: #8a887f;
    margin: 0.4rem 0 0;
  }
  .gallery-body {
    font-size: var(--body-size);
    line-height: var(--body-line);
  }
  .gallery-body :global(p) {
    margin: 0 0 1.2em;
  }
  .gallery-body :global(a) {
    color: inherit;
  }

  /* Standard grid (ordinary galleries) */
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  .grid-item {
    position: relative;
  }
  .grid-item img {
    display: block;
    width: 100%;
    height: auto;
  }
  .grid-item-caption {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    background: rgba(255, 255, 255, 0.92);
    padding: 0.2rem 0.55rem;
    font-size: 0.85rem;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    pointer-events: none;
  }
  .grid-item:hover .grid-item-caption {
    opacity: 1;
    transform: translateY(0);
  }
  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Year-grouped archive (large collections, e.g. Museum of Bottle Drawings) */
  .year-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e5e2d8;
  }
  .year-jump a {
    font-family: 'degular', sans-serif;
    font-size: 0.9rem;
    color: #6b6a63;
    text-decoration: none;
    padding: 0.25rem 0.1rem;
    border-bottom: 1px solid transparent;
  }
  .year-jump a:hover {
    color: rgba(0, 0, 0, 0.9);
    border-bottom-color: currentColor;
  }
  .year-section {
    margin-bottom: 3.5rem;
    scroll-margin-top: 1.5rem;
  }
  .year-heading {
    font-family: 'swear-display', serif;
    font-weight: 600;
    font-size: 1.6rem;
    margin: 0 0 1.25rem;
    color: rgba(0, 0, 0, 0.9);
  }
  .year-grid {
    columns: 3;
    column-gap: 1.5rem;
  }
  .year-grid-item {
    break-inside: avoid;
    margin-bottom: 1.75rem;
  }
  .year-grid-item img {
    display: block;
    width: 100%;
    height: auto;
  }
  .year-caption {
    font-size: 0.8rem;
    font-style: italic;
    color: #6b6a63;
    line-height: 1.4;
    margin-top: 0.5rem;
  }
  .year-caption :global(p) {
    margin: 0;
  }
  .year-caption :global(strong) {
    font-style: normal;
    font-weight: 600;
  }
  @media (max-width: 900px) {
    .year-grid {
      columns: 2;
    }
  }
  @media (max-width: 560px) {
    .year-grid {
      columns: 1;
    }
  }

  .gallery-footer-copy {
    max-width: 120ch;
    font-size: var(--body-size);
    line-height: var(--body-line);
    margin-bottom: 3rem;
  }
  .gallery-footer-copy :global(p) {
    margin: 0 0 1.2em;
  }
  .gallery-footer-copy :global(p:last-child) {
    margin-bottom: 0;
  }
  .gallery-footer-copy :global(a) {
    color: inherit;
  }

  .gallery-pagination {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid #e5e2d8;
    padding-top: 1.5rem;
    font-family: 'degular', sans-serif;
    font-size: var(--body-size);
  }
  .gallery-pagination a {
    color: inherit;
    text-decoration: none;
  }
  .gallery-pagination a:hover .pagination-name {
    text-decoration: underline;
  }
  .pagination-label {
    display: block;
    font-size: 0.8rem;
    color: #6b6a63;
    margin-bottom: 0.15rem;
  }
  .pagination-name {
    font-family: 'swear-display', serif;
    font-weight: 600;
    font-size: 1.1rem;
  }
  .pagination-next {
    text-align: right;
  }
</style>