---
// src/components/GalleryIndex.astro
import {uncroppedUrl, croppedUrl} from '../lib/image';

interface Props {
  title: string;
  blurb?: string;
  bodyCopy?: string;
  headerImage?: any;
  galleries: {title: string; slug: {current: string}; headerImage: any; indexThumbnail?: any}[];
  basePath: string;
}
const {title, blurb, bodyCopy, headerImage, galleries, basePath} = Astro.props;
---

<main>
  {headerImage && <img class="index-header-img" src={croppedUrl(headerImage, 1400, 900)} alt="" />}

  <div class="index-meta">
    <h1 class="index-title">{title}</h1>
    {blurb && (
      <div class="index-body">
        <p>{blurb}</p>
      </div>
    )}
    {bodyCopy && (
      <div class="index-body index-body-extra">
        <p>{bodyCopy}</p>
      </div>
    )}
  </div>

  <div class="index-grid">
    {galleries.map((gallery) => (
      <a class="grid-item" href={`${basePath}/${gallery.slug.current}`} aria-label={`View gallery: ${gallery.title}`}>
        {(gallery.indexThumbnail || gallery.headerImage) && (
          <img src={uncroppedUrl(gallery.indexThumbnail || gallery.headerImage, 900)} alt="" />
        )}
        <span class="grid-item-caption" aria-hidden="true">{gallery.title}</span>
      </a>
    ))}
  </div>
</main>

<style>
  main {
    padding: 2rem 1.5rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .index-header-img {
    width: 100%;
    max-height: 55vh;
    object-fit: cover;
    margin-bottom: 2.5rem;
    background: #ececec;
  }
  .index-meta {
    max-width: 65ch;
    margin-bottom: 3rem;
  }
  .index-title {
    font-family: 'swear-display', serif;
    font-weight: var(--headline-weight);
    font-style: var(--headline-style);
    font-size: 48px;
    line-height: 1.05;
    color: rgba(0, 0, 0, 0.9);
    margin: 0 0 0.75rem;
  }
  .index-body {
    font-size: var(--body-size);
    line-height: var(--body-line);
    color: #6b6a63;
  }
  .index-body p {
    margin: 0;
  }
  .index-body-extra {
    margin-top: 0.75rem;
  }

  .index-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 1.5rem;
  }
  .grid-item {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .grid-item img {
    display: block;
    width: 100%;
    height: auto;
  }
  .grid-item-caption {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    background: rgba(255, 255, 255, 0.92);
    padding: 0.2rem 0.55rem;
    font-size: 0.85rem;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    pointer-events: none;
  }
  .grid-item:hover .grid-item-caption,
  .grid-item:focus-visible .grid-item-caption {
    opacity: 1;
    transform: translateY(0);
  }
  @media (max-width: 640px) {
    .index-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
