---
// src/pages/blog/[...page].astro
//
// Uses Astro's built-in paginate() rather than hand-rolling page chunks
// (the way the earlier standalone prototype did) — this generates /blog,
// /blog/2, /blog/3, etc. automatically as the number of published posts
// grows, no manual page-count math needed.
//
// The year-jump dropdown independently computes which page each year's
// first post falls on, using the exact same sorted post list and page
// size passed to paginate(), so the two stay in sync by construction.

import type {GetStaticPathsOptions} from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {croppedUrl} from '../../lib/image';
import {sanityClient} from '../../lib/sanity';

export async function getStaticPaths({paginate}: GetStaticPathsOptions) {
  const PAGE_SIZE = 10;

  const posts = await sanityClient.fetch(
    `*[_type == "blogPost"] | order(date desc) {
      title, slug, date, excerpt, headerImage, indexThumbnail,
      "firstTextBlock": body[_type == "block"][0].children[].text
    }`
  );

  // Map each year to the (1-indexed) page number and position within
  // that page where its first (most recent) post falls — computed with
  // the same ordering and PAGE_SIZE that paginate() below will use.
  const yearTarget: Record<string, {page: number; globalIndex: number}> = {};
  posts.forEach((post: any, i: number) => {
    const year = new Date(post.date).getFullYear().toString();
    if (!(year in yearTarget)) {
      yearTarget[year] = {page: Math.floor(i / PAGE_SIZE) + 1, globalIndex: i};
    }
  });

  const pages = paginate(posts, {pageSize: PAGE_SIZE});
  return pages.map((p: any) => ({...p, props: {...p.props, yearTarget}}));
}

const {page, yearTarget} = Astro.props as any;
const years = Object.keys(yearTarget).sort((a, b) => Number(b) - Number(a));

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: 'numeric'});
}

function excerptFor(post: any) {
  if (post.excerpt) return post.excerpt;
  if (Array.isArray(post.firstTextBlock)) return post.firstTextBlock.join('');
  return '';
}

function yearHref(year: string) {
  const target = yearTarget[year];
  const pageUrl = target.page === 1 ? '/blog' : `/blog/${target.page}`;
  return `${pageUrl}#post-${target.globalIndex}`;
}
---

<BaseLayout title="Blog" currentPath="/blog">
  <main>
    <h1>Blog</h1>

    <div class="year-jump">
      <label for="year-select">Jump to year: </label>
      <select id="year-select" onchange="window.location.href = this.value">
        <option value="">&mdash;</option>
        {years.map((year) => <option value={yearHref(year)}>{year}</option>)}
      </select>
    </div>

    <div class="post-list">
      {page.data.map((post: any, i: number) => {
        const globalIndex = (page.currentPage - 1) * page.size + i;
        const thumb = post.indexThumbnail || post.headerImage;
        return (
          <a class="post-row" id={`post-${globalIndex}`} href={`/blog/${post.slug.current}`}>
            {thumb && <img class="post-row-thumb" src={croppedUrl(thumb, 260, 260)} alt="" width="260" height="260" />}
            <span class="post-row-content">
              <span class="post-row-date">{formatDate(post.date)}</span>
              <span class="post-row-title">{post.title}</span>
              {excerptFor(post) && <span class="post-row-excerpt">{excerptFor(post)}</span>}
              <span class="post-row-readmore">Read more &rarr;</span>
            </span>
          </a>
        );
      })}
    </div>

    <nav class="pagination-nums" aria-label="Blog pagination">
      {Array.from({length: page.lastPage}, (_, i) => i + 1).map((p) => (
        p === page.currentPage ? (
          <span class="page-num page-num-current">{p}</span>
        ) : (
          <a class="page-num" href={p === 1 ? '/blog' : `/blog/${p}`}>{p}</a>
        )
      ))}
    </nav>
  </main>
</BaseLayout>

<style>
  main {
    padding: 2rem 1.5rem 4rem;
    max-width: 900px;
    margin: 0 auto;
  }
  h1 {
    font-family: 'swear-display', serif;
    font-weight: var(--headline-weight);
    font-style: var(--headline-style);
    font-size: 40px;
    margin: 0 0 1.25rem;
  }

  .year-jump {
    margin-bottom: 2rem;
  }
  .year-jump select {
    font-family: 'degular', sans-serif;
    font-size: 0.95rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid #cfccc2;
    background: #fff;
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }
  .post-row {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
    padding: 1.75rem 0;
    border-top: 1px solid #e5e2d8;
    text-decoration: none;
    color: inherit;
    scroll-margin-top: 2rem;
  }
  .post-list .post-row:last-child {
    border-bottom: 1px solid #e5e2d8;
  }
  .post-row-thumb {
    width: 260px;
    height: 260px;
    object-fit: cover;
    flex: none;
    background: #ececec;
  }
  .post-row-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.1rem;
  }
  .post-row-date {
    font-size: 0.85rem;
    color: #6b6a63;
  }
  .post-row-title {
    font-family: 'swear-display', serif;
    font-weight: 300;
    font-style: normal;
    font-size: 26px;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }
  .post-row-excerpt {
    font-size: var(--body-size);
    line-height: var(--body-line);
    color: #4a4842;
    max-width: 46ch;
  }
  .post-row-readmore {
    font-size: 0.9rem;
    margin-top: 0.3rem;
  }
  .post-row:hover .post-row-title,
  .post-row:hover .post-row-readmore {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .post-row {
      flex-direction: column;
      gap: 1rem;
    }
    .post-row-thumb {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }
  }

  .pagination-nums {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    padding-top: 2rem;
    margin-top: 1rem;
  }
  .page-num {
    font-family: 'degular', sans-serif;
    font-size: 0.95rem;
    color: inherit;
    text-decoration: none;
    padding: 0.3rem 0.6rem;
  }
  .page-num:hover {
    text-decoration: underline;
  }
  .page-num-current {
    font-weight: 700;
    border-bottom: 2px solid var(--color-text);
  }
</style>
