---
// src/pages/collage/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryIndex from '../../components/GalleryIndex.astro';
import {sanityClient} from '../../lib/sanity';

const siteSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);
const galleries = await sanityClient.fetch(
  `*[_type == "gallery" && category == "collage"] | order(orderRank asc) { title, slug, headerImage, indexThumbnail }`
);
---

<BaseLayout title="Collage" currentPath="/collage">
  <GalleryIndex
    title="Collage"
    blurb={siteSettings?.collageBlurb}
    bodyCopy={siteSettings?.collageBodyCopy}
    headerImage={siteSettings?.collageHeaderImage || siteSettings?.defaultHeaderImage}
    galleries={galleries}
    basePath="/collage"
  />
</BaseLayout>